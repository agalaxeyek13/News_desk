POLL_INTERVAL_SECONDS=120
LIVEBLOG_POLL_INTERVAL_SECONDS=15
ENABLE_DESKTOP_NOTIFICATIONS=true
DASHBOARD_PORT=5050
ARTICLE_TTL_HOURS=6
PRUNE_INTERVAL_SECONDS=1800
MC_POLL_INTERVAL_SECONDS=60
MC_LIVE_POLL_INTERVAL_SECONDS=30
ET_POLL_INTERVAL_SECONDS=60
SCANX_POLL_INTERVAL_SECONDS=15
FLASK_SECRET_KEY=
DASHBOARD_PASSWORD=

# FDE Briefing (fde/run_daily.py) — daily US-Iran email digest
# Local GPU LLM (llama-cpp-python) — defaults already point at the Gemma
# GGUF on this machine; override only if the model moves or you want to
# tune context size / GPU layer count.
FDE_LOCAL_MODEL_PATH=
FDE_LOCAL_MODEL_CTX=4096
FDE_LOCAL_MODEL_GPU_LAYERS=-1
# How far back (hours) an article can be published and still count as "today's" news
FDE_RECENCY_HOURS=48
FDE_RECIPIENTS=
FDE_SENDER=
# "outlook" (default, uses the signed-in desktop Outlook app, no credentials
# needed) or "smtp" (needs IT to enable SMTP AUTH on FDE_SMTP_USER's mailbox)
FDE_MAIL_METHOD=outlook
FDE_SMTP_HOST=smtp.office365.com
FDE_SMTP_PORT=587
FDE_SMTP_USER=
FDE_SMTP_PASSWORD=
